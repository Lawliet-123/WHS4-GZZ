# Copy this file to /etc/meccha-anticheat/server.env on the VM.
# Keep the real file readable only by root and the meccha service group.
# Generate independent values, for example: openssl rand -hex 32

GZZ_TELEMETRY_TOKEN=REPLACE_WITH_INDEPENDENT_64_HEX_CHAR_VALUE
MECCHA_HEARTBEAT_TOKEN=REPLACE_WITH_INDEPENDENT_64_HEX_CHAR_VALUE
GZZ_DASHBOARD_TOKEN=REPLACE_WITH_INDEPENDENT_64_HEX_CHAR_VALUE
GZZ_DASHBOARD_CURSOR_SECRET=REPLACE_WITH_INDEPENDENT_64_HEX_CHAR_VALUE

# Persistent server-side state. Do not place these paths inside the Git checkout.
GZZ_TELEMETRY_LOG_ROOT=/var/lib/meccha-anticheat/detections
GZZ_SCORING_DB=/var/lib/meccha-anticheat/scoring/scoring.sqlite3
MECCHA_HEARTBEAT_DB=/var/lib/meccha-anticheat/heartbeat/heartbeat.sqlite3
GZZ_DASHBOARD_INDEX=/var/lib/meccha-anticheat/dashboard/dashboard.sqlite3

# Existing application defaults, made explicit for production review.
GZZ_TELEMETRY_MAX_EVENT_BYTES=262144
GZZ_TELEMETRY_WRITE_LOCK_TIMEOUT_SECONDS=3
GZZ_DASHBOARD_STALE_AFTER_MS=30000
