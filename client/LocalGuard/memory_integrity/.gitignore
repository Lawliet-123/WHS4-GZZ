# 게임 바이너리에서 파생된 산출물 — 재배포하지 않는다
CppSDK/
*.usmap

# 빌드 산출물
build/
bin/
*.dll
*.exe
*.obj
*.pdb
*.lib
*.ilk
*.exp

# 수집 로그 — 폴더만 남기고 내용은 올리지 않는다
logs/raw/*
logs/detection/*
!logs/**/.gitkeep

__pycache__/
*.pyc

# 중앙 전송 대기열 — 러너마다 따로 생긴다. 보낼 결과를 담고 있을 뿐이라 커밋하지 않는다.
logs/outbox/
# 반복 관측 기준점 — 다음 실행이 이어 읽으려고 쓰는 런타임 파일이다.
logs/detection/*.watch.json
