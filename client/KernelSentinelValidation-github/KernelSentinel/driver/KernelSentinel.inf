[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=01/01/2020,0.1.0.0
CatalogFile=KernelSentinel.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=KernelSentinel,0,KernelSentinel_Service

[KernelSentinel_Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\KernelSentinel.sys

[DriverCopyFiles]
KernelSentinel.sys

[SourceDisksFiles]
KernelSentinel.sys=1

[SourceDisksNames]
1=%DiskName%,,,

[Strings]
ProviderName="Meccha AntiCheat Research"
ServiceName="KernelSentinel"
DiskName="KernelSentinel test package"
